{
  "name": "@questfall/api-contract",
  "version": "3.7.0",
  "private": true,
  "type": "module",
  "description": "Versioned public API contract between Questfall application and PocketBase",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Questfall-HQ/questfall-api-contract.git"
  },
  "bugs": "https://github.com/Questfall-HQ/questfall-api-contract/issues",
  "homepage": "https://github.com/Questfall-HQ/questfall-api-contract#readme",
  "exports": {
    ".": "./src/index.js",
    "./contract": "./contract.json",
    "./schemas": "./schemas.json",
    "./check": "./src/check.mjs",
    "./validate": "./src/validate.js"
  },
  "bin": {
    "questfall-contract-check": "./bin/check.mjs"
  },
  "scripts": {
    "check": "bun run bin/check.mjs --contract",
    "test": "bun test",
    "verify": "bun test && bun run check"
  }
}
